# ==============================================================================
# PAWCONNECT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your actual secrets.
# Never commit real credentials or .env files to GitHub.

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication & Cookie Signing
# REQUIRED in production. Generate a secure random string (e.g. openssl rand -hex 32).
JWT_SECRET=

# Seed Credentials (Optional: supply if you want seeder to create initial accounts)
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
USER_INITIAL_EMAIL=
USER_INITIAL_PASSWORD=

# Client URL (for CORS allowance in Express)
CLIENT_URL=http://localhost:3000

# ==============================================================================
# PRODUCTION PERSISTENT DATABASE (SUPABASE / POSTGRESQL)
# ==============================================================================
# On Vercel serverless, the local filesystem (/tmp) is ephemeral.
# To persist data across serverless restarts, supply your PostgreSQL credentials:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase API Credentials (Optional):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
